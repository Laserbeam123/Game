{
  "sheet": "btd6_art",
  "about": "What Bloons Ops takes from the player's own Bloons TD 6 install (never redistributed). Each row maps one Bloons Ops tower or bloon (or the pop sound) to the BTD6 asset that shows it. BTD6's Addressables bundles carry content hashes in their file names and change with every BTD6 update, so a row names its asset by name patterns, tried in order, and its bundle by a file glob; tools/btd6/bloonsops_btd6.py resolves them on the player's PC and records the exact asset and bundle in @bloonsops_btd6/manifest.json. A row with no match keeps the Bloons Ops look. Rows stay 'designed' until a real BTD6 install has confirmed them (run the converter's inspect command and pin the names here).",
  "columns": [
    {
      "name": "id",
      "type": "id",
      "desc": "towers or bloons id in Bloons Ops"
    },
    {
      "name": "uses",
      "type": "enum",
      "values": [
        "tower",
        "bloon",
        "sound"
      ]
    },
    {
      "name": "btd6_asset",
      "type": "patterns",
      "desc": "|-separated regexes (case-insensitive, full match) on Sprite/Texture2D names (AudioClip for sounds), best first"
    },
    {
      "name": "btd6_bundle",
      "type": "globs",
      "desc": "|-separated file globs relative to the BTD6 install folder"
    },
    {
      "name": "out_file",
      "type": "string",
      "desc": "file the converter writes into @bloonsops_btd6 (PAA for images, OGG for sounds)"
    },
    {
      "name": "status",
      "type": "status"
    }
  ],
